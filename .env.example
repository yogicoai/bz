# ────────── MongoDB ──────────
# 광고대시보드/onlineData 와 같은 공유 클러스터를 쓰되 DB 는 분리
EMAILDATA_URI=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=emaildata

# ────────── Claude (번역·요약·기한 추출) ──────────
ANTHROPIC_API_KEY=
# 기본값 claude-opus-5. 물량이 많아 비용을 낮추려면 claude-sonnet-5 로 교체
CLAUDE_MODEL=claude-opus-5

# ────────── IMAP 수신 (이카운트 웹메일) ──────────
# 실제 서버 주소는 이카운트 웹메일 → 환경설정 → IMAP/POP 설정 에서 확인
# 설정 화면에서 입력하면 DB 에 저장되며, 아래 값은 초기 기본값으로만 쓰임
IMAP_HOST=
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=
IMAP_PASS=
IMAP_FOLDER=INBOX

# ────────── SMTP 발신 ──────────
SMTP_HOST=wsmtp.ecount.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
MAIL_FROM_NAME=요기보
MAIL_FROM_ADDRESS=

# 1 이면 실제 발송하지 않고 콘솔에 페이로드만 출력 (개발 중 권장)
MAIL_DRY_RUN=1

# ────────── 접근 제어 (웹 배포 시 필수) ──────────
# 이 비밀번호를 아는 사람만 접근 가능. 미설정 시 인증 없이 열림(로컬 개발용)
APP_PASSWORD=
# 로그인 쿠키 서명용 랜덤 문자열
APP_SECRET=change-me-to-a-random-string

# ────────── 수집 스케줄 ──────────
# Vercel Cron 이 /api/cron/ingest 를 호출할 때 검증하는 시크릿
CRON_SECRET=change-me-to-a-random-string
# scripts/poll.js 주기(분) — 상시 실행 서버에서만 사용
POLL_INTERVAL_MIN=10

# 1 이면 정리 파일을 data/mails/ 에도 저장 (로컬 개발용, 서버리스에서는 끌 것)
DOC_WRITE_LOCAL=0

APP_BASE_URL=http://localhost:5900
